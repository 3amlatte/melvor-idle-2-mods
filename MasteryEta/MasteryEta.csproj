<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <AssemblyName>MasteryEta</AssemblyName>
    <RootNamespace>MasteryEta</RootNamespace>
    <Version>0.1.1</Version>

    <!-- Build straight into the game: mods\MasteryEta\MasteryEta.dll -->
    <OutputPath>$(GameDir)\mods\$(AssemblyName)\</OutputPath>
  </PropertyGroup>

  <ItemGroup>
    <Content Include="icons\*.png" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="icons\*.jpg" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="icons\*.webp" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <ItemGroup>
    <Reference Include="MelvorModLoader">
      <HintPath>$(GameDir)\data_MelvorModLoader_windows_x86_64\MelvorModLoader.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="GodotSharp">
      <HintPath>$(GameDir)\data_GamesByMalcs.Melvor2_windows_x86_64\GodotSharp.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="GamesByMalcs.Melvor2">
      <HintPath>$(GameDir)\data_GamesByMalcs.Melvor2_windows_x86_64\GamesByMalcs.Melvor2.dll</HintPath>
      <Private>false</Private>
    </Reference>
  </ItemGroup>
</Project>
